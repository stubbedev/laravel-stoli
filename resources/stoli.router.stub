import axios, { AxiosRequestConfig, AxiosResponse } from 'axios';
import { RouteService } from '{{STOLI}}';
import routes, {
	type {{STUDLY}}RouteParams,
	type {{STUDLY}}RouteResponse,
	type {{STUDLY}}GetRouteName,
	type {{STUDLY}}PostRouteName,
	type {{STUDLY}}PutRouteName,
	type {{STUDLY}}PatchRouteName,
	type {{STUDLY}}DeleteRouteName,
} from './{{MODULE}}';

type {{STUDLY}}RouteResponseType<N extends keyof {{STUDLY}}RouteParams> =
	N extends keyof {{STUDLY}}RouteResponse ? {{STUDLY}}RouteResponse[N] : Record<string, unknown>;

const routeService = new RouteService({ routes });

function buildUrl<N extends keyof {{STUDLY}}RouteParams>(
	routeName: N,
	params: {{STUDLY}}RouteParams[N] | FormData,
): [string, Record<string, unknown> | FormData] {
	if (params instanceof FormData) {
		const remaining: Record<string, unknown> = {};
		params.forEach((value, key) => { remaining[key] = value; });
		const url = routeService.createURLWithoutQuery(routeName as keyof typeof routes & string, remaining);

		// createURLWithoutQuery drops the keys it put in the path; the rest is the body
		const body = new FormData();
		params.forEach((value, key) => {
			if (key in remaining) {
				body.append(key, value);
			}
		});

		return [url, body];
	}

	const remaining = { ...params } as Record<string, unknown>;
	const url = routeService.createURLWithoutQuery(routeName as keyof typeof routes & string, remaining);
	return [url, remaining];
}

// A body holding a File/Blob has to go out as multipart; axios serializes the object
// itself once the Content-Type says so, which keeps the params fully typed.
// Top level and one array level only; hand a FormData in for deeper shapes.
function withMultipart(body: Record<string, unknown> | FormData, config: AxiosRequestConfig): AxiosRequestConfig {
	if (body instanceof FormData) {
		return config;
	}

	const hasFile = Object.values(body).some(
		(value) => value instanceof Blob || (Array.isArray(value) && value.some((item) => item instanceof Blob)),
	);

	return hasFile
		? { ...config, headers: { 'Content-Type': 'multipart/form-data', ...config.headers } }
		: config;
}

export const Stoli = {
	get<N extends {{STUDLY}}GetRouteName>(routeName: N, params?: {{STUDLY}}RouteParams[N], config: AxiosRequestConfig = {}): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, queryParams] = buildUrl(routeName, params ?? {} as {{STUDLY}}RouteParams[N]);
		return axios.get<{{STUDLY}}RouteResponseType<N>>(url, { ...config, params: { ...queryParams, ...(config.params as Record<string, unknown> | undefined) } });
	},

	post<N extends {{STUDLY}}PostRouteName>(routeName: N, params?: {{STUDLY}}RouteParams[N] | FormData, config: AxiosRequestConfig = {}): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params ?? {} as {{STUDLY}}RouteParams[N]);
		return axios.post<{{STUDLY}}RouteResponseType<N>>(url, body, withMultipart(body, config));
	},

	put<N extends {{STUDLY}}PutRouteName>(routeName: N, params?: {{STUDLY}}RouteParams[N] | FormData, config: AxiosRequestConfig = {}): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params ?? {} as {{STUDLY}}RouteParams[N]);
		return axios.put<{{STUDLY}}RouteResponseType<N>>(url, body, withMultipart(body, config));
	},

	patch<N extends {{STUDLY}}PatchRouteName>(routeName: N, params?: {{STUDLY}}RouteParams[N] | FormData, config: AxiosRequestConfig = {}): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params ?? {} as {{STUDLY}}RouteParams[N]);
		return axios.patch<{{STUDLY}}RouteResponseType<N>>(url, body, withMultipart(body, config));
	},

	delete<N extends {{STUDLY}}DeleteRouteName>(routeName: N, params?: {{STUDLY}}RouteParams[N], config: AxiosRequestConfig = {}): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, queryParams] = buildUrl(routeName, params ?? {} as {{STUDLY}}RouteParams[N]);
		return axios.delete<{{STUDLY}}RouteResponseType<N>>(url, { ...config, params: { ...queryParams, ...(config.params as Record<string, unknown> | undefined) } });
	},
};
