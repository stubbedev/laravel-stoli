import axios, { AxiosRequestConfig, AxiosResponse } from 'axios';
import { RouteService, flattenParameters, serializeQuery } from '{{STOLI}}';
import routes, {
	type {{STUDLY}}RouteParams,
	type {{STUDLY}}RouteResponse,
	type {{STUDLY}}GetRouteName,
	type {{STUDLY}}PostRouteName,
	type {{STUDLY}}PutRouteName,
	type {{STUDLY}}PatchRouteName,
	type {{STUDLY}}DeleteRouteName,
} from './{{MODULE}}';

type {{STUDLY}}RouteResponseType<N extends keyof {{STUDLY}}RouteParams> =
	N extends keyof {{STUDLY}}RouteResponse ? {{STUDLY}}RouteResponse[N] : Record<string, unknown>;

type Body = Record<string, unknown> | FormData;

// The parameters may only be left out when the route has none that are required.
type Arguments<P> = Record<string, never> extends P
	? [params?: P, config?: AxiosRequestConfig]
	: [params: P, config?: AxiosRequestConfig];

const routeService = new RouteService({ routes });

// The route name and parameters are checked by the methods below; the service is
// called with the plain shapes it works on.
const createURLWithoutQuery = routeService.createURLWithoutQuery.bind(routeService) as (
	name: string,
	parameters: Record<string, unknown>,
) => string;

function buildUrl(routeName: string, params: object | FormData | undefined): [string, Body] {
	if (params instanceof FormData) {
		const remaining: Record<string, unknown> = {};
		params.forEach((value, key) => { remaining[key] = value; });
		const url = createURLWithoutQuery(routeName, remaining);

		// createURLWithoutQuery drops the keys it put in the path; the rest is the body
		const body = new FormData();
		params.forEach((value, key) => {
			if (Object.prototype.hasOwnProperty.call(remaining, key)) {
				body.append(key, value);
			}
		});

		return [url, body];
	}

	const remaining: Record<string, unknown> = { ...params };
	const url = createURLWithoutQuery(routeName, remaining);

	return [url, remaining];
}

// A body holding a File or Blob anywhere has to go out as multipart. It is flattened the
// way PHP reads it back, so nested fields and booleans arrive as Laravel expects them.
function toBody(body: Body): Body {
	if (body instanceof FormData) {
		return body;
	}

	const pairs = flattenParameters(body);

	if (!pairs.some(([, value]) => value instanceof Blob)) {
		return body;
	}

	const form = new FormData();
	pairs.forEach(([key, value]) => form.append(key, value));

	return form;
}

// Query parameters are serialized by the route service, the same way generateFullURL does.
function withQuery(query: Body, config: AxiosRequestConfig): AxiosRequestConfig {
	return {
		paramsSerializer: (params) => serializeQuery(params),
		...config,
		params: { ...query, ...(config.params as Record<string, unknown> | undefined) },
	};
}

// PHP only parses multipart bodies on POST, so a PUT or PATCH carrying files is sent as a
// POST that Laravel's method spoofing routes back to the PUT or PATCH route.
function send<T>(method: 'put' | 'patch', url: string, body: Body, config: AxiosRequestConfig): Promise<AxiosResponse<T>> {
	const data = toBody(body);

	if (!(data instanceof FormData)) {
		return axios[method]<T>(url, data, config);
	}

	if (!data.has('_method')) {
		data.append('_method', method.toUpperCase());
	}

	return axios.post<T>(url, data, config);
}

export const Stoli = {
	get<N extends {{STUDLY}}GetRouteName>(routeName: N, ...[params, config = {}]: Arguments<{{STUDLY}}RouteParams[N]>): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, query] = buildUrl(routeName, params);
		return axios.get<{{STUDLY}}RouteResponseType<N>>(url, withQuery(query, config));
	},

	post<N extends {{STUDLY}}PostRouteName>(routeName: N, ...[params, config = {}]: Arguments<{{STUDLY}}RouteParams[N] | FormData>): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params);
		return axios.post<{{STUDLY}}RouteResponseType<N>>(url, toBody(body), config);
	},

	put<N extends {{STUDLY}}PutRouteName>(routeName: N, ...[params, config = {}]: Arguments<{{STUDLY}}RouteParams[N] | FormData>): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params);
		return send<{{STUDLY}}RouteResponseType<N>>('put', url, body, config);
	},

	patch<N extends {{STUDLY}}PatchRouteName>(routeName: N, ...[params, config = {}]: Arguments<{{STUDLY}}RouteParams[N] | FormData>): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, body] = buildUrl(routeName, params);
		return send<{{STUDLY}}RouteResponseType<N>>('patch', url, body, config);
	},

	delete<N extends {{STUDLY}}DeleteRouteName>(routeName: N, ...[params, config = {}]: Arguments<{{STUDLY}}RouteParams[N]>): Promise<AxiosResponse<{{STUDLY}}RouteResponseType<N>>> {
		const [url, query] = buildUrl(routeName, params);
		return axios.delete<{{STUDLY}}RouteResponseType<N>>(url, withQuery(query, config));
	},
};
