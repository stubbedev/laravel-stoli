export class RouteService {
	#routes;
	#rootUrl;

	constructor({ routes, rootUrl = null }) {
		this.#routes = routes;
		this.#rootUrl = rootUrl;
	}

	has(name) {
		return Object.hasOwn(this.#routes, name);
	}

	createURLWithoutQuery(name, parameters) {
		return this.#create(name, parameters, { withQueryString: false });
	}

	generateFullURL(name, parameters = {}) {
		// Copied: unlike createURLWithoutQuery, callers here keep their object intact
		return this.#create(name, { ...parameters }, { withQueryString: true });
	}

	#create(name, parameters, options = { withQueryString: true }) {
		const route = this.#find(name);
		const hostname = this.#getHostname(route);
		const path = this.#replaceNamedParameters(name, route.uri, parameters);
		const qs = options.withQueryString ? this.#getRouteQueryString(parameters) : null;

		return this.#buildUri(hostname, path, qs);
	}

	#find(name) {
		if (!this.has(name)) {
			throw new Error(`Not found route: ${name}`);
		}

		return this.#routes[name];
	}

	#getHostname(route) {
		return this.#rootUrl ?? route.host ?? '';
	}

	// eslint-disable-next-line class-methods-use-this
	#replaceNamedParameters(name, uri, parameters) {
		// The leading slash is part of the match so an absent optional parameter
		// takes its own path segment with it.
		return uri.replace(/\/?{(\w+)(\??)}/g, (match, key, optional) => {
			const value = Object.prototype.hasOwnProperty.call(parameters, key) ? parameters[key] : null;

			if (value === null || value === undefined) {
				if (!optional) {
					throw new Error(`Missing required parameter "${key}" for route: ${name}`);
				}

				return '';
			}

			// eslint-disable-next-line no-param-reassign
			delete parameters[key];

			return `${match.startsWith('/') ? '/' : ''}${encodeURIComponent(value)}`;
		});
	}

	// eslint-disable-next-line class-methods-use-this
	#getRouteQueryString(parameters) {
		const query = new URLSearchParams();

		Object.entries(parameters).forEach(([key, value]) => {
			if (value === null || value === undefined) {
				return;
			}

			// Arrays go out Laravel-style; nested objects are not handled, so flatten them first.
			if (Array.isArray(value)) {
				value.forEach((item) => query.append(`${key}[]`, item));

				return;
			}

			query.append(key, value);
		});

		return query.toString();
	}

	// eslint-disable-next-line class-methods-use-this
	#buildUri(hostname, path, queryString) {
		return [`${hostname.replace(/\/+$/, '')}/${path}`, queryString].filter((s) => s).join('?');
	}
}

export default RouteService;

/**
 * Create a standalone `route()` function bound to a RouteService instance.
 * Prefer this over importing the class when tree-shaking matters.
 *
 * @example
 * import { createRoute } from './stoli.js';
 * import routes from './api.js';
 *
 * const route = createRoute({ routes });
 * route('users.show', { id: 1 }); // → '/users/1'
 */
export function createRoute(config) {
	const service = new RouteService(config);
	return (name, parameters = {}) => service.generateFullURL(name, parameters);
}
